# .env.example
# Vetted by AI - Manual Review Required by Senior Engineer/Manager
# ─────────────────────────────────────────────────────────────────────
# HYBRID COGNITIVE PIPELINE — Environment Configuration
# Copy file ini ke .env dan isi dengan API key Anda
# JANGAN commit file .env ke git (sudah ada di .gitignore)
# ─────────────────────────────────────────────────────────────────────

# ── OpenRouter API (Free Tier) ────────────────────────────────────────
# Daftar di: https://openrouter.ai
# Free models tersedia tanpa biaya dengan rate limit moderat
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model default untuk causal reasoning (pilih dari daftar free models):
#   meta-llama/llama-3.3-70b-instruct:free        ← Recommended (stabil, 70B)
#   nvidia/nemotron-3-ultra-550b-a55b:free         ← Paling powerful (550B)
#   nvidia/nemotron-3-super-120b-a12b:free         ← Balance speed/quality (120B)
#   qwen/qwen3-coder:free                          ← Sangat besar (480B)
#   nousresearch/hermes-3-llama-3.1-405b:free      ← 405B alternative
#   openai/gpt-oss-120b:free                       ← OpenAI OSS 120B
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Ollama Local (Llama 3.2) ──────────────────────────────────────────
# URL Ollama lokal (default: localhost)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Pipeline Mode ─────────────────────────────────────────────────────
# hybrid  → Llama lokal (PII gate) + OpenRouter cloud (reasoning)
# local   → Semua lokal (Llama 3.2, tanpa cloud)
# cloud   → Semua via OpenRouter (tidak ada Ollama diperlukan)
PIPELINE_MODE=hybrid

# ── Cache Settings ────────────────────────────────────────────────────
# Aktifkan caching untuk menghindari biaya API berulang
ENABLE_LLM_CACHE=true
